{
  "schemaVersion": 1,
  "description": "完整指令池编辑示例：客户格式可自行定义。MOVE 已支持预览，FAN 仅保存参数关系，发送待实现。",
  "external": {
    "encoding": "ascii",
    "header": "!",
    "footer": "\\r",
    "byteOrder": "big",
    "fields": [
      {"name": "命令码", "role": "command", "type": "ascii", "lengthMode": "mappedCommand"},
      {"name": "数值", "role": "parameter", "type": "uint", "lengthMode": "toFooter", "min": 0, "max": 6000}
    ]
  },
  "mappings": [
    {
      "commandCode": "MOVE",
      "operation": "ABSOLUTE_MOVE",
      "responsePolicy": "ack",
      "parameters": {"positionUm": {"kind": "field", "field": "数值"}}
    },
    {
      "commandCode": "FAN",
      "operation": "QUSHENG_81",
      "responsePolicy": "ack",
      "parameters": {
        "devId": {"kind": "constant", "value": 224},
        "percent": {"kind": "field", "field": "数值"}
      }
    }
  ],
  "device": {
    "destination": 2,
    "source": 1,
    "devId": 17,
    "absoluteAction": 1,
    "speedUmPerS": 1000,
    "minPositionUm": 0,
    "maxPositionUm": 6000
  }
}
