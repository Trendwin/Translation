{
  "schemaVersion": 1,
  "name": "单条运动和查询验证示例（客户格式可编辑，数值直接引用）",
  "external": {
    "encoding": "ascii",
    "header": "/",
    "footer": "R\\r",
    "byteOrder": "big",
    "fields": [
      {"name":"地址","role":"parameter","type":"uint","lengthMode":"fixed","length":1,"min":1,"max":9},
      {"name":"命令码","role":"command","type":"ascii","lengthMode":"mappedCommand"},
      {"name":"位置","role":"parameter","type":"uint","lengthMode":"toFooter","min":0,"max":6000}
    ]
  },
  "mappings": [
    {"commandCode":"A","operation":"ABSOLUTE_MOVE","responsePolicy":"ack","parameters":{"positionUm":{"kind":"field","field":"位置"}}},
    {"commandCode":"a","operation":"ABSOLUTE_MOVE","responsePolicy":"complete","parameters":{"positionUm":{"kind":"field","field":"位置"}}},
    {"commandCode":"P","operation":"RELATIVE_FORWARD","responsePolicy":"ack","parameters":{"distanceUm":{"kind":"field","field":"位置"}}},
    {"commandCode":"p","operation":"RELATIVE_FORWARD","responsePolicy":"complete","parameters":{"distanceUm":{"kind":"field","field":"位置"}}},
    {"commandCode":"D","operation":"RELATIVE_BACKWARD","responsePolicy":"ack","parameters":{"distanceUm":{"kind":"field","field":"位置"}}},
    {"commandCode":"d","operation":"RELATIVE_BACKWARD","responsePolicy":"complete","parameters":{"distanceUm":{"kind":"field","field":"位置"}}},
    {"commandCode":"?","operation":"QUERY_MOTOR","responsePolicy":"ack","parameters":{},"input":{"omitFields":["位置"],"footer":"\\r"}},
    {"commandCode":"?0","operation":"QUERY_MOTOR","responsePolicy":"ack","parameters":{},"input":{"omitFields":["位置"],"footer":"\\r"}},
    {"commandCode":"?4","operation":"QUERY_MOTOR","responsePolicy":"ack","parameters":{},"input":{"omitFields":["位置"],"footer":"\\r"}},
    {"commandCode":"&","operation":"QUERY_DEVICE_INFO","responsePolicy":"ack","parameters":{},"input":{"omitFields":["位置"],"footer":"\\r"}},
    {"commandCode":"?23","operation":"QUERY_DEVICE_INFO","responsePolicy":"ack","parameters":{},"input":{"omitFields":["位置"],"footer":"\\r"}}
  ],
  "device": {
    "destination":2,"source":1,"devId":17,"absoluteAction":1,
    "speedUmPerS":1000,"minPositionUm":0,"maxPositionUm":6000
  }
}
