# Windows / MSVC build outputs
*.exp
*.lib
*.user

# Keep output directory placeholders
!bin/
!bin/debug/
!bin/release/
!bin/debug/.gitkeep
!bin/release/.gitkeep
# Generated application output
/bin/debug/*
/bin/release/*
!/bin/debug/.gitkeep
!/bin/release/.gitkeep
