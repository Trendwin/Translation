Widget, QDialog#axisFormulaDialog {
    background-color: #f1f5f9;
}

QLabel {
    color: #14263c;
}

QLabel:disabled {
    color: #475569;
}

QLabel[uiRole="heading"] {
    color: #14263c;
    font-size: 18px;
    font-weight: bold;
}

QLabel[uiRole="muted"] {
    color: #475569;
}

QWidget#configBar {
    background-color: #ffffff;
    border-top: 1px solid #d5e0ec;
}

QLabel[uiRole="badge"], QPushButton[uiRole="badge"] {
    background-color: #e9eff7;
    color: #36485e;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 7px;
    font-weight: bold;
}

QLabel[uiRole="badge"][uiState="ok"], QPushButton[uiRole="badge"][uiState="ok"] {
    background-color: #e8f6ed;
    color: #166534;
}

QLabel[uiRole="badge"][uiState="notice"], QPushButton[uiRole="badge"][uiState="notice"] {
    background-color: #fef3c7;
    color: #92400e;
}

QLabel[uiRole="badge"][uiState="error"], QPushButton[uiRole="badge"][uiState="error"] {
    background-color: #fee2e2;
    color: #991b1b;
}

QPushButton[uiRole="badge"]:hover, QPushButton[uiRole="badge"]:focus {
    border-color: #1e40af;
}

QTabWidget::pane {
    border: 1px solid #cbd6e3;
    border-radius: 4px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid transparent;
    border-bottom: 2px solid #d5e0ec;
    margin-right: 2px;
    padding: 4px 11px;
}

QTabBar::tab:hover {
    background-color: #dfeaf8;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #1e40af;
    border-bottom-color: #1e40af;
}

QTabBar::tab:focus {
    border-color: #1e40af;
    background-color: #eaf1ff;
}

QGroupBox {
    color: #14263c;
    background-color: #ffffff;
    border: 1px solid #d5e0ec;
    border-radius: 5px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 9px;
    padding: 0 4px;
    font-weight: bold;
}

QTableWidget, QPlainTextEdit, QTextEdit {
    background-color: #ffffff;
    color: #24364b;
    border: 1px solid #cbd6e3;
    selection-background-color: #d9eaff;
    selection-color: #173b6a;
}

QTableWidget {
    alternate-background-color: #f5f8fc;
    gridline-color: #e1e8f0;
}

QTableWidget::item:selected:active {
    background-color: #c4dfff;
    color: #173b6a;
}

QTableWidget::item:selected:!active {
    background-color: #d9eaff;
    color: #173b6a;
}

QHeaderView::section {
    background-color: #edf3f9;
    color: #334963;
    border: 0;
    border-right: 1px solid #d4dfe9;
    border-bottom: 1px solid #d4dfe9;
    padding: 2px 5px;
}

QLineEdit {
    background-color: #ffffff;
    color: #24364b;
    border: 1px solid #bccbdb;
    border-radius: 3px;
    padding: 2px 5px;
    selection-background-color: #c4dfff;
    selection-color: #173b6a;
}

QSpinBox QLineEdit {
    border: 0;
    border-radius: 0;
    padding: 0;
}

QTableWidget:focus, QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border-color: #2767b4;
}

QLineEdit:disabled, QLineEdit:read-only {
    background-color: #f0f3f7;
    color: #425872;
}

QPushButton {
    background-color: #ffffff;
    color: #14263c;
    border: 1px solid #9caec4;
    border-radius: 4px;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #ecf4ff;
    border-color: #7298c7;
}

QPushButton:pressed {
    background-color: #d9eaff;
}

QPushButton:focus {
    background-color: #eaf1ff;
    border-color: #1e40af;
    outline: none;
}

QPushButton#saveConfig, QPushButton#formulaAccept, QPushButton[uiRole="primary"] {
    background-color: #1e40af;
    color: #ffffff;
    border-color: #1e40af;
}

QPushButton#saveConfig:hover, QPushButton#formulaAccept:hover, QPushButton[uiRole="primary"]:hover {
    background-color: #1e3a8a;
}

QPushButton#saveConfig:pressed, QPushButton#formulaAccept:pressed, QPushButton[uiRole="primary"]:pressed {
    background-color: #142b70;
}

QPushButton#saveConfig:focus, QPushButton#formulaAccept:focus, QPushButton[uiRole="primary"]:focus {
    background-color: #234bbd;
    border-color: #14263c;
    outline: none;
}

QPushButton:disabled, QPushButton#saveConfig:disabled, QPushButton#formulaAccept:disabled, QPushButton[uiRole="primary"]:disabled {
    background-color: #edf1f6;
    color: #64758a;
    border-color: #d4dfe9;
}

QPushButton[objectName^="axisFormulaButton_"] {
    padding: 0;
    border-radius: 3px;
}

QSplitter::handle {
    background-color: #dce5f0;
}

QSplitter::handle:hover {
    background-color: #a8c5e8;
}
